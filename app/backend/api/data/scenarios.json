{
  "port-strike": {
    "mutations": [
      {
        "op": "set",
        "path": ["kpis", "lostSales"],
        "value": {"value": "$4.2M", "trendSymbol": "▲", "trendClass": "down"}
      },
      {
        "op": "prepend",
        "path": ["alerts", "global"],
        "value": {"type": "critical", "text": "SIMULATION: Port Strike impact high. Rerouting recommended."}
      },
      {
        "op": "set",
        "path": ["charts", "revenue", "revenueData"],
        "value": [60, 50, 40, 80, 70]
      },
      {
        "op": "set",
        "path": ["charts", "revenue", "colors"],
        "value": ["red", "red", "red", "red", "red"]
      }
    ]
  },
  "geopolitical": {
    "mutations": [
      {
        "op": "set",
        "path": ["kpis", "turnover"],
        "value": {"value": "3.1x", "trendSymbol": "▼", "trendClass": "down"}
      },
      {
        "op": "prepend",
        "path": ["alerts", "global"],
        "value": {"type": "critical", "text": "SIMULATION: Suez blockage. 14-day delay projected."}
      }
    ]
  }
}
