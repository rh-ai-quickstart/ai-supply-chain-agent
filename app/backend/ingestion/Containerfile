FROM python:3.12-slim

# Numeric UID required: Kind/Kubernetes rejects runAsNonRoot when USER is a name.
RUN useradd -u 1001 -m appuser

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt && \
    rm -rf /root/.cache

COPY . ./

RUN chown -R appuser:0 /app && chmod -R g+rwX /app
USER 1001

CMD ["python", "main.py"]
